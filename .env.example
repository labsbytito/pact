# Optional direct API provider. Put actual credentials only in .env or process environment.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5   # default when unset

# Opt-in local development/testing with your already-signed-in Claude Code CLI:
# PACT_AI=claude-code
# PACT_CLAUDE_MODEL=claude-sonnet-5-5   # optional; unset uses the CLI's own default (not verified against the CLI)
# Budget caps apply to both providers; reserved spend lives in .local/ai-usage.json and is never reset by the app.
# PACT_AI_REQUEST_CAP=0.15
# PACT_AI_SESSION_CAP=1

# Off by default. Set to 1 to let Pact propose start_fo_call and any future Fo tool
# other than ask_fo or a read-only get_*/list_* tool. Those actions still require
# a separate confirmation in the review dialog before anything is sent.
# PACT_FO_CONSEQUENTIAL=
