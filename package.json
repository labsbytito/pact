{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "WXT_PUBLIC_PACT_API=http://localhost:3000 wxt",
    "build": "WXT_PUBLIC_PACT_API=http://localhost:3000 wxt build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "zip": "PACT_STORE_BUILD=1 wxt zip",
    "zip:release": "set -a; . ./.env.production; set +a; wxt zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wxt": "0.21.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
